# Copie para .env e troque os valores marcados.

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
# Em produção, atrás do nginx com TLS, ponha 1 nas duas linhas abaixo.
DJANGO_BEHIND_TLS_PROXY=0
DJANGO_SECURE_COOKIES=0
DJANGO_TRUST_X_REAL_IP=1
FRONTEND_URL=http://localhost

# --- Banco (usado pelo Django e pelo container do Postgres) ---
POSTGRES_DB=tributo360
POSTGRES_USER=tributo360
POSTGRES_PASSWORD=troque-esta-senha

# --- E-mail (convites e redefinição de senha) ---
# Em desenvolvimento os e-mails saem no log do container django.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Tributo360 <nao-responda@tributo360.local>

# --- Porta publicada pelo nginx ---
HTTP_PORT=80

# --- Motores (opcional; os padrões seguem o planejamento) ---
# MOTORES_TIMEOUT_CALCULO=5
# MOTORES_TIMEOUT_CONEXAO=2
# MOTORES_CIRCUITO_FALHAS=5
# MOTORES_CIRCUITO_JANELA_SEGUNDOS=60
# MOTORES_CIRCUITO_ABERTO_SEGUNDOS=30
